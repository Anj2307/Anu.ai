# Copy this file to `.streamlit/secrets.toml` for local development,
# or paste these keys into the "Secrets" panel of your app on
# Streamlit Community Cloud (Manage app -> Settings -> Secrets).
#
# Do NOT commit the real secrets.toml — it is gitignored.
#
# RAG uses local BM25 keyword search, so NO embedding/Google key is needed.

OPENROUTER_API_KEY = "sk-or-your-openrouter-key"
TAVILY_API_KEY = "tvly-your-tavily-key"
